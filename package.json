{
  "name": "composers-desktop-application",
  "description": "Alpha desktop interface for exploring and running reviewed Composers' Desktop Project audio processes.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint src/ && cargo clippy --manifest-path src-tauri/Cargo.toml",
    "lint:fix": "oxlint src/ --fix && cargo clippy --fix --manifest-path src-tauri/Cargo.toml --allow-dirty",
    "fmt": "oxfmt src/ && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "oxfmt src/ --check && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "compile:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "version:check": "bun ./scripts/check-version.ts",
    "bump:patch": "bun ./scripts/bump-version.ts patch",
    "bump:minor": "bun ./scripts/bump-version.ts minor",
    "bump:major": "bun ./scripts/bump-version.ts major"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/ui": "^4.11.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.3.4",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^5.0.2",
    "vite": "^5.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.10"
  }
}
