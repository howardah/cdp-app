{
  "description": "Testing and linting hooks",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "Compile Check",
            "type": "command",
            "command": "bun run compile:check",
            "statusMessage": "Checking for compile errors…",
            "description": "Lints the codebase for compile errors"
          },
          {
            "name": "Lint",
            "type": "command",
            "command": "bun run lint:fix",
            "statusMessage": "Checking for linting errors…",
            "description": "Lints the codebase for linting errors"
          },
          {
            "name": "Format",
            "type": "command",
            "command": "bun run fmt",
            "statusMessage": "Formatting codebase…",
            "description": "Formats the codebase"
          }
        ]
      }
    ]
  }
}
