{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CDP Desktop process definition",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "category", "summary", "description", "useCases", "tags", "identity", "documentation", "modes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "category": { "enum": ["time-domain", "spectral", "edit-and-mix", "utilities"] },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "useCases": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "identity": { "type": "object", "required": ["executable"], "properties": { "executable": { "enum": ["modify", "sfedit", "pvoc", "isolate"] }, "operation": { "type": "string" } }, "additionalProperties": false },
    "documentation": { "type": "object", "required": ["localPath", "helpCommand", "verifiedWithVersion"], "properties": { "localPath": { "type": "string" }, "anchor": { "type": "string" }, "helpCommand": { "type": "array", "items": { "type": "string" } }, "verifiedWithVersion": { "type": "string" } }, "additionalProperties": false },
    "modes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "title", "summary", "inputs", "parameters", "output", "argumentOrder", "constraints"] } }
  },
  "additionalProperties": false
}
