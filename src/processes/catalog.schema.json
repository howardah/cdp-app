{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CDP Desktop process definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "category",
    "summary",
    "description",
    "useCases",
    "tags",
    "identity",
    "documentation",
    "modes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/definitions/id" },
    "title": { "$ref": "#/definitions/text" },
    "category": { "enum": ["time-domain", "spectral", "edit-and-mix", "utilities"] },
    "summary": { "$ref": "#/definitions/text" },
    "description": { "$ref": "#/definitions/text" },
    "useCases": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": { "enum": ["modify", "sfedit", "pvoc", "isolate", "sfprops"] },
        "operation": { "$ref": "#/definitions/id" }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localPath", "helpCommand", "verifiedWithVersion"],
      "properties": {
        "localPath": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string" },
        "helpCommand": { "type": "array", "items": { "type": "string" } },
        "verifiedWithVersion": { "type": "string", "minLength": 1 }
      }
    },
    "modes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/mode" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*(?:-[a-zA-Z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "fileType": {
      "enum": [
        "soundfile",
        "analysis-ana",
        "analysis-pvx",
        "breakpoint",
        "cuts-data",
        "slice-data",
        "text-data",
        "binary-envelope",
        "mixfile",
        "domain-image"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "oneOf": [
        { "properties": { "kind": { "const": "positional" } } },
        {
          "required": ["flag", "join"],
          "properties": {
            "kind": { "const": "option" },
            "flag": { "type": "string", "pattern": "^-[A-Za-z0-9][A-Za-z0-9-]*$" },
            "join": { "enum": ["concatenated", "separate"] }
          }
        },
        {
          "required": ["flag"],
          "properties": {
            "kind": { "const": "booleanFlag" },
            "flag": { "type": "string", "pattern": "^-[A-Za-z0-9][A-Za-z0-9-]*$" }
          }
        }
      ]
    },
    "fileConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["channels", "sameSampleRate", "sameChannels", "sameSampleFormat", "sameDuration"]
        },
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "inputId": { "$ref": "#/definitions/id" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "fileTypes",
        "minItems",
        "maxItems",
        "ordered",
        "constraints"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "fileTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/fileType" }
        },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": ["integer", "null"], "minimum": 0 },
        "ordered": { "type": "boolean" },
        "constraints": { "type": "array", "items": { "$ref": "#/definitions/fileConstraint" } }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "required", "advanced", "cli", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "$ref": "#/definitions/text" },
        "description": { "$ref": "#/definitions/text" },
        "required": { "type": "boolean" },
        "advanced": { "type": "boolean" },
        "unit": { "type": "string" },
        "cli": { "$ref": "#/definitions/binding" },
        "kind": { "enum": ["number", "integer", "choice", "flag", "file", "numberOrBreakpoint"] },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label", "cliValue"],
            "properties": {
              "value": { "type": "string" },
              "label": { "$ref": "#/definitions/text" },
              "cliValue": { "type": "string" }
            }
          }
        },
        "fileTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/fileType" }
        },
        "breakpointType": { "const": "time-value-pairs" }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["source", "id"],
          "properties": { "source": { "const": "parameter" }, "id": { "$ref": "#/definitions/id" } }
        },
        {
          "required": ["source", "inputId", "property"],
          "properties": {
            "source": { "const": "inputMetadata" },
            "inputId": { "$ref": "#/definitions/id" },
            "property": { "enum": ["duration", "channels"] }
          }
        },
        {
          "required": ["source", "value"],
          "properties": { "source": { "const": "literal" }, "value": { "type": "number" } }
        }
      ]
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "type": "string", "pattern": "^[^\\u0000]*$" }
          }
        },
        { "required": ["kind"], "properties": { "kind": { "const": "mode" } } },
        {
          "required": ["kind", "inputId"],
          "properties": { "kind": { "const": "input" }, "inputId": { "$ref": "#/definitions/id" } }
        },
        { "required": ["kind"], "properties": { "kind": { "const": "output" } } },
        {
          "required": ["kind", "parameterId"],
          "properties": {
            "kind": { "const": "parameter" },
            "parameterId": { "$ref": "#/definitions/id" }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["kind", "fileType", "extension", "nameSuffix"],
          "properties": {
            "kind": { "const": "singleFile" },
            "fileType": { "$ref": "#/definitions/fileType" },
            "extension": { "type": "string", "pattern": "^[a-z0-9]+$" },
            "nameSuffix": { "type": "string", "pattern": "^[^\\u0000/\\\\]*$" }
          }
        },
        {
          "required": ["kind", "fileType", "extension", "nameSuffix", "discovery"],
          "properties": {
            "kind": { "const": "genericRoot" },
            "fileType": { "$ref": "#/definitions/fileType" },
            "extension": { "type": "string", "pattern": "^[a-z0-9]+$" },
            "nameSuffix": { "type": "string" },
            "discovery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prefixStyle", "mayProduceRemnant"],
              "properties": {
                "prefixStyle": { "enum": ["root-number", "root-number-padded"] },
                "mayProduceRemnant": { "type": "boolean" }
              }
            }
          }
        },
        {
          "required": ["kind", "fileType", "extension", "nameSuffix", "discovery"],
          "properties": {
            "kind": { "const": "autoNamedGeneric" },
            "fileType": { "$ref": "#/definitions/fileType" },
            "extension": { "type": "string", "pattern": "^[a-z0-9]+$" },
            "nameSuffix": { "type": "string", "pattern": "^[^\\u0000/\\\\]*$" },
            "discovery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prefixStyle", "mayProduceRemnant"],
              "properties": {
                "prefixStyle": { "enum": ["root-number", "root-number-padded"] },
                "mayProduceRemnant": { "type": "boolean" }
              }
            }
          }
        },
        {
          "required": ["kind", "extension", "nameSuffix", "components"],
          "properties": {
            "kind": { "const": "composite" },
            "extension": { "type": "string", "pattern": "^[a-z0-9]+$" },
            "nameSuffix": { "type": "string", "pattern": "^[^\\u0000/\\\\]*$" },
            "components": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fileType", "extension", "nameSuffix"],
                "properties": {
                  "fileType": { "$ref": "#/definitions/fileType" },
                  "extension": { "type": "string", "pattern": "^[a-z0-9]+$" },
                  "nameSuffix": { "type": "string", "pattern": "^[^\\u0000/\\\\]*$" }
                }
              }
            }
          }
        },
        { "required": ["kind"], "properties": { "kind": { "enum": ["stdoutReport", "none"] } } }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["kind", "left", "right", "message"],
          "properties": {
            "kind": { "enum": ["lessThan", "lessThanOrEqual", "greaterThan"] },
            "left": { "$ref": "#/definitions/ref" },
            "right": { "$ref": "#/definitions/ref" },
            "message": { "$ref": "#/definitions/text" }
          }
        },
        {
          "required": ["kind", "value", "message"],
          "properties": {
            "kind": { "const": "powerOfTwo" },
            "value": { "$ref": "#/definitions/ref" },
            "message": { "$ref": "#/definitions/text" }
          }
        }
      ]
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "inputs",
        "parameters",
        "output",
        "argumentOrder",
        "constraints"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "cliMode": { "type": "integer", "minimum": 0, "maximum": 255 },
        "title": { "$ref": "#/definitions/text" },
        "summary": { "$ref": "#/definitions/text" },
        "inputs": { "type": "array", "items": { "$ref": "#/definitions/input" } },
        "parameters": { "type": "array", "items": { "$ref": "#/definitions/parameter" } },
        "output": { "$ref": "#/definitions/output" },
        "argumentOrder": { "type": "array", "items": { "$ref": "#/definitions/argument" } },
        "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint" } }
      }
    }
  }
}
