          "unit": "Hz",
          "cli": { "kind": "positional" },
          "kind": "integer",
          "default": 44100,
          "min": 1,
          "step": 1
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "binary-pitch",
        "extension": "frq",
        "nameSuffix": "-generate"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "generate"
        },
        {
          "kind": "output"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        { "kind": "parameter", "parameterId": "sampleRate" }
      ],
      "constraints": []
    }
  ]
