{
  "schemaVersion": 1,
  "id": "repitch-generate",
  "title": "Repitch generate",
  "category": "spectral",
  "summary": "CDP Repitch generate operation.",
  "description": "Run the documented CDP Release 8 Repitch generate operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["repitch", "generate", "cdp-release-8"],
  "identity": {
    "executable": "repitch",
    "operation": "generate"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/crepitch.htm",
    "helpCommand": ["repitch", "generate"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "process",
      "title": "Repitch generate",
      "summary": "Run Repitch generate.",
      "inputs": [
        {
          "id": "source",
          "label": "MIDI pitch data",
          "description": "Text file of increasing time and MIDI-pitch pairs.",
          "fileTypes": ["text-data"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "sampleRate",
          "label": "Sample rate",
          "description": "Sample rate for analysis timing in the generated pitch file.",
