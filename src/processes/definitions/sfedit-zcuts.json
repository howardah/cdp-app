          "prefixStyle": "root-number",
          "mayProduceRemnant": false
        }
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "zcuts"
        },
        {
          "kind": "mode"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        {
          "kind": "input",
          "inputId": "cuttimes"
        }
      ],
      "constraints": []
    },
