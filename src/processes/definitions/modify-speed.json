{
  "schemaVersion": 1,
  "id": "modify-speed",
  "title": "Modify Speed",
  "category": "time-domain",
  "summary": "Change sound speed and pitch.",
  "description": "Modify playback speed, transposition, acceleration, or vibrato for a soundfile.",
  "useCases": [
    "Transpose a recording",
    "Create slower practice versions",
    "Accelerate or decelerate a sound",
    "Add vibrato"
  ],
  "tags": ["speed", "pitch", "transpose", "accelerate", "vibrato", "modify"],
  "identity": { "executable": "modify", "operation": "speed" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgromody.htm",
    "anchor": "SPEED",
    "helpCommand": ["modify", "speed"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "ratio",
      "cliMode": 1,
      "title": "Speed ratio",
      "summary": "Vary speed and pitch by a ratio.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to modify.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "ratio",
          "label": "Speed ratio",
          "description": "Playback multiplier; 1 leaves speed unchanged. A breakpoint file may vary it over time.",
          "required": true,
          "advanced": false,
          "unit": "×",
          "cli": { "kind": "positional" },
          "kind": "numberOrBreakpoint",
          "default": { "kind": "number", "value": 1 },
          "min": 0.01,
          "max": 100,
          "step": 0.01,
          "breakpointType": "time-value-pairs"
        },
        {
          "id": "outputTimes",
          "label": "Read breakpoint times in output",
          "description": "Interpret breakpoint times against the output rather than input.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-o" },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-speed"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "speed" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "ratio" },
        { "kind": "parameter", "parameterId": "outputTimes" }
      ],
      "constraints": []
    },
    {
      "id": "semitones",
      "cliMode": 2,
      "title": "Semitone transposition",
      "summary": "Vary speed and pitch by semitones.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to transpose.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "semitones",
          "label": "Transposition",
          "description": "Semitones relative to the original speed; a breakpoint file may vary it over time.",
          "required": true,
          "advanced": false,
          "unit": "semitones",
          "cli": { "kind": "positional" },
          "kind": "numberOrBreakpoint",
          "default": { "kind": "number", "value": 0 },
          "min": -96,
          "max": 96,
          "step": 0.01,
          "breakpointType": "time-value-pairs"
        },
        {
          "id": "outputTimes",
          "label": "Read breakpoint times in output",
          "description": "Interpret breakpoint times against input or output.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-o" },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-speed"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "speed" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "semitones" },
        { "kind": "parameter", "parameterId": "outputTimes" }
      ],
      "constraints": []
    },
    {
      "id": "accelerate",
      "cliMode": 5,
      "title": "Accelerate or decelerate",
      "summary": "Reach a speed ratio at a target time.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to accelerate or decelerate.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "acceleration",
          "label": "Goal speed ratio",
          "description": "Speed multiplier reached at the goal time.",
          "required": true,
          "advanced": false,
          "unit": "×",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0.01,
          "max": 100,
          "step": 0.01
        },
        {
          "id": "goalTime",
          "label": "Goal time",
          "description": "Output time at which the goal speed is reached.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0,
          "step": 0.01
        },
        {
          "id": "startTime",
          "label": "Start time",
          "description": "Input/output time at which acceleration begins.",
          "required": false,
          "advanced": true,
          "unit": "s",
          "cli": { "kind": "option", "flag": "-s", "join": "concatenated" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-accelerated"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "speed" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "acceleration" },
        { "kind": "parameter", "parameterId": "goalTime" },
        { "kind": "parameter", "parameterId": "startTime" }
      ],
      "constraints": []
    },
    {
      "id": "vibrato",
      "cliMode": 6,
      "title": "Vibrato",
      "summary": "Add time-varying vibrato to a sound.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to modulate.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "rate",
          "label": "Vibrato rate",
          "description": "Oscillation rate; a breakpoint file may vary it over time.",
          "required": true,
          "advanced": false,
          "unit": "Hz",
          "cli": { "kind": "positional" },
          "kind": "numberOrBreakpoint",
          "default": { "kind": "number", "value": 5 },
          "min": 0,
          "max": 120,
          "step": 0.01,
          "breakpointType": "time-value-pairs"
        },
        {
          "id": "depth",
          "label": "Vibrato depth",
          "description": "Pitch modulation width; a breakpoint file may vary it over time.",
          "required": true,
          "advanced": false,
          "unit": "semitones",
          "cli": { "kind": "positional" },
          "kind": "numberOrBreakpoint",
          "default": { "kind": "number", "value": 0 },
          "min": 0,
          "max": 96,
          "step": 0.01,
          "breakpointType": "time-value-pairs"
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-vibrato"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "speed" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "rate" },
        { "kind": "parameter", "parameterId": "depth" }
      ],
      "constraints": []
    }
  ]
}
