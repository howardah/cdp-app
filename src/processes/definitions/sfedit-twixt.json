          "kind": "number",
          "default": 15,
          "min": 0,
          "max": 500,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-twixt"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "twixt"
        },
        {
          "kind": "mode"
        },
        {
          "kind": "input",
          "inputId": "sources"
        },
        {
          "kind": "output"
        },
        {
          "kind": "input",
          "inputId": "switchTimes"
        },
        {
          "kind": "parameter",
          "parameterId": "spliceMs"
        }
      ],
      "constraints": []
    }
  ]
