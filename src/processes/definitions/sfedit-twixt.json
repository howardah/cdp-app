{
  "schemaVersion": 1,
  "id": "sfedit-twixt",
  "title": "SFEdit Twixt",
  "category": "edit-and-mix",
  "summary": "Switch between soundfiles at times.",
  "description": "Build a sound by switching among parallel sources.",
  "useCases": ["Edit a recording", "Assemble sound"],
  "tags": ["switch", "segments", "sequence"],
  "identity": {
    "executable": "sfedit",
    "operation": "twixt"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroedit.htm",
    "anchor": "TWIXT",
    "helpCommand": ["sfedit", "twixt"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "sequence",
      "title": "sequence",
      "summary": "sequence",
      "inputs": [
        {
          "id": "sources",
          "label": "Soundfiles",
          "description": "Ordered source files.",
          "fileTypes": ["soundfile"],
          "minItems": 2,
          "maxItems": null,
          "ordered": true,
          "constraints": []
        },
        {
          "id": "switchTimes",
          "label": "Switch times",
          "description": "Increasing segment boundaries.",
          "fileTypes": ["text-data"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
