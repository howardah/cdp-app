{
  "schemaVersion": 1,
  "id": "focus-focus",
  "title": "Focus Spectral Peaks",
  "category": "spectral",
  "summary": "Concentrate energy around prominent peaks.",
  "description": "Apply peak-centred spectral filtering to a PVOC analysis.",
  "useCases": ["Emphasize resonances", "Sharpen spectral character"],
  "tags": ["focus", "peaks", "filter"],
  "identity": { "executable": "focus", "operation": "focus" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cfocus.htm",
    "anchor": "FOCUS",
    "helpCommand": ["focus", "focus"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "formant",
      "title": "Focus by frequency",
      "summary": "Find peaks using a frequency-wise envelope.",
      "inputs": [
        {
          "id": "source",
          "label": "Analysis file",
          "description": "PVOC analysis file.",
          "fileTypes": ["analysis-ana"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "points",
          "label": "Envelope points",
          "description": "Frequency spacing for formant envelope extraction.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "option", "flag": "-f", "join": "concatenated" },
          "kind": "integer",
          "default": 8,
          "min": 1,
          "step": 1
        },
        {
          "id": "peaks",
          "label": "Peaks",
          "description": "Maximum number of peaks to find.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "integer",
          "default": 4,
          "min": 1,
          "max": 16,
          "step": 1
        },
        {
          "id": "bandwidth",
          "label": "Bandwidth",
          "description": "Bandwidth of peak-centred filters in octaves.",
          "required": true,
          "advanced": false,
          "unit": "octaves",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0.5,
          "min": 0.001,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "analysis-ana",
        "extension": "ana",
        "nameSuffix": "-focused"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "focus" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "points" },
        { "kind": "parameter", "parameterId": "peaks" },
        { "kind": "parameter", "parameterId": "bandwidth" }
      ],
      "constraints": []
    }
  ]
}
