{
  "schemaVersion": 1,
  "id": "grain-grev",
  "title": "Grain grev",
  "category": "time-domain",
  "summary": "Find and manipulate grains from envelope troughs.",
  "description": "Locate grains using envelope troughs and zero crossings.",
  "useCases": ["Speech grain editing"],
  "tags": ["grain", "trough", "zero-crossing"],
  "identity": { "executable": "grain", "operation": "grev" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgrogrns.htm",
    "anchor": "GREV",
    "helpCommand": ["grain", "grev"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "reverse",
      "cliMode": 1,
      "title": "Reverse grain groups",
      "summary": "Reverse units of grains.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "windowMs",
          "label": "Window",
          "description": "Grain window size.",
          "required": true,
          "advanced": false,
          "unit": "ms",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 20,
          "min": 0.001,
          "step": 0.001
        },
        {
          "id": "trough",
          "label": "Trough",
          "description": "Acceptable trough height.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0.5,
          "min": 0.001,
          "max": 0.999,
          "step": 0.001
        },
        {
          "id": "groupCount",
          "label": "Grains per unit",
          "description": "Grains in each unit.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "numberOrBreakpoint",
          "default": { "kind": "number", "value": 1 },
          "min": 1,
          "step": 1,
          "breakpointType": "time-value-pairs"
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-grev-reverse"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "grev" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "windowMs" },
        { "kind": "parameter", "parameterId": "trough" },
        { "kind": "parameter", "parameterId": "groupCount" }
      ],
      "constraints": []
    },
