{
  "schemaVersion": 1,
  "id": "filter-bankfrqs",
  "title": "Generate Harmonic Filter Frequencies",
  "category": "utilities",
  "summary": "Create a harmonic frequency list for a filter bank.",
  "description": "Generate a text frequency list bounded by the source sampling rate.",
  "useCases": ["Design a harmonic filter bank"],
  "tags": ["filter", "frequencies", "harmonics"],
  "identity": { "executable": "filter", "operation": "bankfrqs" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgrofilt.htm",
    "anchor": "BANKFRQS",
    "helpCommand": ["filter", "bankfrqs"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "harmonic",
      "cliMode": 1,
      "title": "Harmonic series",
      "summary": "Generate harmonics above a lowest frequency.",
      "inputs": [
        {
          "id": "source",
          "label": "Reference soundfile",
          "description": "Soundfile used to establish the valid frequency range.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "low-hz",
          "label": "Lowest frequency",
          "description": "First harmonic frequency.",
          "required": true,
          "advanced": false,
          "unit": "Hz",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 100,
          "min": 0,
          "step": 1
        },
        {
          "id": "high-hz",
          "label": "Highest frequency",
          "description": "Upper limit for generated frequencies.",
          "required": true,
          "advanced": false,
          "unit": "Hz",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 5000,
          "min": 1,
          "step": 1
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "text-data",
        "extension": "txt",
        "nameSuffix": "-filter-frequencies"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "bankfrqs" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "low-hz" },
        { "kind": "parameter", "parameterId": "high-hz" }
      ],
      "constraints": [
        {
          "kind": "lessThan",
          "left": { "source": "parameter", "id": "low-hz" },
          "right": { "source": "parameter", "id": "high-hz" },
          "message": "Lowest frequency must be below highest frequency."
        }
      ]
    }
  ]
}
