{
  "schemaVersion": 1,
  "id": "repitch-vowels",
  "title": "Repitch vowels",
  "category": "spectral",
  "summary": "CDP Repitch vowels operation.",
  "description": "Run the documented CDP Release 8 Repitch vowels operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["repitch", "vowels", "cdp-release-8"],
  "identity": {
    "executable": "repitch",
    "operation": "vowels"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/crepitch.htm",
    "helpCommand": ["repitch", "vowels"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "process",
      "title": "Repitch vowels",
      "summary": "Run Repitch vowels.",
      "inputs": [
        {
          "id": "source",
          "label": "Binary pitch file",
          "description": "Source required by CDP Repitch vowels.",
          "fileTypes": ["binary-pitch"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "vowelData",
          "label": "Vowel data",
          "description": "Text file containing one vowel symbol or time/vowel pairs.",
          "fileTypes": ["text-data"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "halfwidth",
          "label": "Formant half-width",
          "description": "Formant width as a fraction of centre frequency.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0.01,
          "max": 10,
          "step": 0.01
        },
        {
          "id": "curve",
          "label": "Peak curve",
          "description": "Steepness of each formant peak.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0.1,
          "max": 10,
          "step": 0.01
        },
        {
          "id": "peakRange",
          "label": "Peak range",
          "description": "Formant-peak amplitude range relative to total range.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "id": "fundamentalWeight",
          "label": "Fundamental weight",
          "description": "Amplitude weighting of the fundamental.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "id": "frequencyOffset",
          "label": "Frequency offset",
          "description": "Scattering of harmonic frequencies from their true values.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "analysis-ana",
        "extension": "ana",
        "nameSuffix": "-vowels"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "vowels"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        { "kind": "input", "inputId": "vowelData" },
        { "kind": "parameter", "parameterId": "halfwidth" },
        { "kind": "parameter", "parameterId": "curve" },
        { "kind": "parameter", "parameterId": "peakRange" },
        { "kind": "parameter", "parameterId": "fundamentalWeight" },
        { "kind": "parameter", "parameterId": "frequencyOffset" }
      ],
      "constraints": []
    }
