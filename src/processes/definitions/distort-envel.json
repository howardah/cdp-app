{
  "schemaVersion": 1,
  "id": "distort-envel",
  "title": "Distort envel",
  "category": "time-domain",
  "summary": "CDP Distort envel operation.",
  "description": "Run the documented CDP Release 8 Distort envel operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["distort", "envel", "cdp-release-8"],
  "identity": {
    "executable": "distort",
    "operation": "envel"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cdistort.htm",
    "helpCommand": ["distort", "envel"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "rising",
      "cliMode": 1,
      "title": "Rising wavecycle envelope",
      "summary": "Impose a rising envelope over each group of wavecycles.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source required by CDP Distort envel.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [{ "kind": "channels", "min": 1, "max": 1 }]
        }
      ],
      "parameters": [
        {
          "id": "cycleCount",
          "label": "Cycles per envelope",
          "description": "Number of wavecycles under one envelope.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "integer",
          "default": 2,
          "min": 1,
          "step": 1
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-envel"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "envel"
        },
        { "kind": "mode" },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        { "kind": "parameter", "parameterId": "cycleCount" }
      ],
      "constraints": []
    },
    {
      "id": "falling",
      "cliMode": 2,
      "title": "Falling wavecycle envelope",
      "summary": "Impose a falling envelope.",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "Source sound.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [{ "kind": "channels", "min": 1, "max": 1 }]
        }
      ],
      "parameters": [
        {
          "id": "cycleCount",
          "label": "Cycles per envelope",
          "description": "Number of wavecycles under one envelope.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "integer",
          "default": 2,
          "min": 1,
          "step": 1
        }
