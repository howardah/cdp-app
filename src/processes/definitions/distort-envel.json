      "argumentOrder": [
        { "kind": "literal", "value": "envel" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "cycleCount" }
      ],
      "constraints": []
    },
    {
      "id": "troughed",
      "cliMode": 3,
      "title": "Troughed wavecycle envelope",
      "summary": "Impose a troughed envelope.",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "Source sound.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
