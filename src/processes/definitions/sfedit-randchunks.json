{
  "schemaVersion": 1,
  "id": "sfedit-randchunks",
  "title": "SFEdit Random Chunks",
  "category": "edit-and-mix",
  "summary": "Extract randomly positioned chunks.",
  "description": "Create numbered chunks from a source.",
  "useCases": ["Edit a recording", "Assemble sound"],
  "tags": ["random", "chunks", "segments"],
  "identity": {
    "executable": "sfedit",
    "operation": "randchunks"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroedit.htm",
    "anchor": "RANDCHUNKS",
    "helpCommand": ["sfedit", "randchunks"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "chunks",
      "title": "chunks",
      "summary": "chunks",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source soundfile.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "count",
          "label": "Chunk count",
          "description": "Number of chunks.",
          "required": true,
          "advanced": false,
          "cli": {
            "kind": "positional"
          },
          "kind": "integer",
          "default": 4,
          "min": 1,
          "max": 10000,
          "step": 1
        },
        {
          "id": "minimumLength",
          "label": "Minimum length",
          "description": "Minimum chunk duration in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 0.1,
          "min": 0.05,
          "step": 0.01
        },
        {
          "id": "maximumLength",
          "label": "Maximum length",
          "description": "Maximum chunk duration in seconds.",
          "required": false,
          "advanced": true,
          "unit": "s",
          "cli": {
            "kind": "option",
            "flag": "-m",
            "join": "concatenated"
          },
          "kind": "number",
          "default": 1,
          "min": 0.05,
          "step": 0.01
        },
        {
          "id": "evenlyDistributed",
          "label": "Evenly distribute",
          "description": "Distribute chunks across the source.",
          "required": false,
          "advanced": true,
          "cli": {
            "kind": "booleanFlag",
            "flag": "-l"
          },
          "kind": "flag",
          "default": false
        },
        {
          "id": "startAtBeginning",
          "label": "Start at beginning",
          "description": "Start all chunks at the beginning.",
          "required": false,
          "advanced": true,
          "cli": {
            "kind": "booleanFlag",
            "flag": "-s"
          },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "autoNamedGeneric",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-randchunks",
        "discovery": {
          "prefixStyle": "root-number",
          "mayProduceRemnant": false
        }
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "randchunks"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "parameter",
          "parameterId": "count"
        },
        {
          "kind": "parameter",
          "parameterId": "minimumLength"
        },
        {
          "kind": "parameter",
          "parameterId": "maximumLength"
        },
        {
          "kind": "parameter",
          "parameterId": "evenlyDistributed"
        },
        {
          "kind": "parameter",
          "parameterId": "startAtBeginning"
        }
      ],
      "constraints": [
        {
          "kind": "lessThanOrEqual",
          "left": { "source": "parameter", "id": "minimumLength" },
          "right": { "source": "parameter", "id": "maximumLength" },
          "message": "Minimum chunk length must not exceed maximum chunk length."
        }
      ]
    }
  ]
}
