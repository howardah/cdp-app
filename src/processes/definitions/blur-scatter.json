{
  "schemaVersion": 1,
  "id": "blur-scatter",
  "title": "Scatter Spectrum",
  "category": "spectral",
  "summary": "Randomly thin spectral components.",
  "description": "Keep a controlled number of randomly selected spectral blocks in each analysis window.",
  "useCases": ["Thin dense spectra", "Create sparse timbres"],
  "tags": ["scatter", "spectrum", "thin", "random"],
  "identity": { "executable": "blur", "operation": "scatter" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cblur.htm",
    "anchor": "SCATTER",
    "helpCommand": ["blur", "scatter"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "scatter",
      "title": "Scatter",
      "summary": "Keep a chosen number of spectral blocks.",
      "inputs": [
        {
          "id": "source",
          "label": "Analysis file",
          "description": "PVOC analysis file.",
          "fileTypes": ["analysis-ana"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "keep",
          "label": "Blocks to keep",
          "description": "Number of randomly selected blocks to retain.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "integer",
          "default": 8,
          "min": 1,
          "step": 1
        },
        {
          "id": "blockSize",
          "label": "Block size",
          "description": "Frequency span of each block in channels.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "option", "flag": "-b", "join": "concatenated" },
          "kind": "integer",
          "default": 1,
          "min": 1,
          "step": 1
        },
        {
          "id": "randomCount",
          "label": "Randomize count",
          "description": "Randomize the selected block count.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-r" },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "analysis-ana",
        "extension": "ana",
        "nameSuffix": "-scattered"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "scatter" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "keep" },
        { "kind": "parameter", "parameterId": "blockSize" },
        { "kind": "parameter", "parameterId": "randomCount" }
      ],
      "constraints": []
    }
  ]
}
