{
  "schemaVersion": 1,
  "id": "distort-interact",
  "title": "Distort interact",
  "category": "time-domain",
  "summary": "CDP Distort interact operation.",
  "description": "Run the documented CDP Release 8 Distort interact operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["distort", "interact", "cdp-release-8"],
  "identity": {
    "executable": "distort",
    "operation": "interact"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cdistort.htm",
    "helpCommand": ["distort", "interact"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "process",
      "title": "Distort interact",
      "summary": "Run Distort interact.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source required by CDP Distort interact.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "second",
          "label": "Second mono soundfile",
          "description": "Second source for wavecycle interaction.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [
            { "kind": "channels", "min": 1, "max": 1 },
            { "kind": "sameSampleRate", "inputId": "source" }
          ]
        }
      ],
      "parameters": [
        {
          "id": "mode",
          "label": "Interaction mode",
          "description": "1 interleaves wavecycles; 2 imposes source wavecycle lengths on the second sound.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "integer",
          "default": 1,
          "min": 1,
          "max": 2,
          "step": 1
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-interact"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "interact"
        },
        { "kind": "parameter", "parameterId": "mode" },
        {
          "kind": "input",
          "inputId": "source"
        },
        { "kind": "input", "inputId": "second" },
        {
          "kind": "output"
        }
      ],
      "constraints": []
    }
  ]
}
