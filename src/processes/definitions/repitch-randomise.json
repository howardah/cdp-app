{
  "schemaVersion": 1,
  "id": "repitch-randomise",
  "title": "Repitch randomise",
  "category": "spectral",
  "summary": "CDP Repitch randomise operation.",
  "description": "Run the documented CDP Release 8 Repitch randomise operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["repitch", "randomise", "cdp-release-8"],
  "identity": {
    "executable": "repitch",
    "operation": "randomise"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/crepitch.htm",
    "helpCommand": ["repitch", "randomise"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "process",
      "title": "Repitch randomise",
      "summary": "Run Repitch randomise.",
      "inputs": [
        {
          "id": "source",
          "label": "Binary pitch file",
          "description": "Source required by CDP Repitch randomise.",
          "fileTypes": ["binary-pitch"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "maximumInterval",
          "label": "Maximum interval",
          "description": "Maximum positive or negative pitch variation in semitones.",
          "required": true,
          "advanced": false,
          "unit": "semitones",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 96,
          "step": 0.001
        },
        {
          "id": "timeStep",
          "label": "Maximum timestep",
          "description": "Maximum time between random fluctuations.",
          "required": true,
          "advanced": false,
          "unit": "ms",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 100,
          "min": 0.001,
          "step": 0.001
        },
        {
          "id": "slew",
          "label": "Slew",
          "description": "Bias upward or downward variation; values must exceed 1 in magnitude.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "option", "flag": "-s", "join": "concatenated" },
          "kind": "number",
          "default": 2,
          "min": 1.001,
          "step": 0.001
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "binary-pitch",
        "extension": "frq",
        "nameSuffix": "-randomise"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "randomise"
        },
        { "kind": "literal", "value": "1" },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        { "kind": "parameter", "parameterId": "maximumInterval" },
        { "kind": "parameter", "parameterId": "timeStep" },
        { "kind": "parameter", "parameterId": "slew" }
      ],
      "constraints": []
    }
