      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-pluck"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "pluck"
        },
        {
          "kind": "mode"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        {
          "kind": "parameter",
          "parameterId": "startSample"
        },
        {
          "kind": "parameter",
          "parameterId": "waveLength"
        },
        {
          "kind": "parameter",
          "parameterId": "attackCycles"
        },
        {
          "kind": "parameter",
          "parameterId": "decayRate"
        }
      ],
      "constraints": []
    }
