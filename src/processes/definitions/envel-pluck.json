          "advanced": false,
          "cli": {
            "kind": "positional"
          },
          "kind": "integer",
          "default": 0,
          "min": 0,
          "max": 100000000,
          "step": 1
        },
        {
          "id": "waveLength",
          "label": "Wavelength",
          "description": "Wave length in samples.",
          "required": true,
          "advanced": false,
          "cli": {
            "kind": "positional"
          },
          "kind": "integer",
          "default": 100,
          "min": 1,
          "max": 100000000,
          "step": 1
        },
        {
          "id": "attackCycles",
          "label": "Attack cycles",
          "description": "Attack wave cycles.",
          "required": false,
          "advanced": false,
          "cli": {
            "kind": "option",
            "flag": "-a",
            "join": "concatenated"
          },
          "kind": "integer",
          "default": 32,
          "min": 2,
          "max": 32767,
          "step": 1
        },
        {
          "id": "decayRate",
          "label": "Decay rate",
          "description": "Decay rate.",
          "required": false,
          "advanced": false,
          "cli": {
            "kind": "option",
            "flag": "-d",
            "join": "concatenated"
          },
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 100,
          "step": 0.01
