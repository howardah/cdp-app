{
  "schemaVersion": 1,
  "id": "envel-pluck",
  "title": "Envel Pluck",
  "category": "time-domain",
  "summary": "Give a mono sound a plucked onset.",
  "description": "Apply a short plucked attack to a mono source.",
  "useCases": ["Shape a recording", "Sound design"],
  "tags": ["pluck", "attack", "mono"],
  "identity": {
    "executable": "envel",
    "operation": "pluck"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroenvl.htm",
    "anchor": "PLUCK",
    "helpCommand": ["envel", "pluck"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "pluck",
      "title": "pluck",
      "summary": "pluck",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "Mono source.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [
            {
              "kind": "channels",
              "min": 1,
              "max": 1
            }
          ]
        }
      ],
      "parameters": [
        {
          "id": "startSample",
