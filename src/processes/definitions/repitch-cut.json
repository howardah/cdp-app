{
  "schemaVersion": 1,
  "id": "repitch-cut",
  "title": "Repitch cut",
  "category": "spectral",
  "summary": "CDP Repitch cut operation.",
  "description": "Run the documented CDP Release 8 Repitch cut operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["repitch", "cut", "cdp-release-8"],
  "identity": {
    "executable": "repitch",
    "operation": "cut"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/crepitch.htm",
    "helpCommand": ["repitch", "cut"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "process",
      "title": "Repitch cut",
      "summary": "Run Repitch cut.",
      "inputs": [
        {
          "id": "source",
          "label": "Binary pitch file",
          "description": "Source required by CDP Repitch cut.",
          "fileTypes": ["binary-pitch"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "startTime",
          "label": "Start time",
          "description": "Start of the retained range.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.001
        },
        {
          "id": "endTime",
          "label": "End time",
          "description": "End of the retained range.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0,
          "step": 0.001
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "binary-pitch",
        "extension": "frq",
        "nameSuffix": "-cut"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "cut"
        },
        { "kind": "literal", "value": "3" },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        { "kind": "parameter", "parameterId": "startTime" },
        { "kind": "parameter", "parameterId": "endTime" }
      ],
      "constraints": [
        {
          "kind": "lessThan",
          "left": { "source": "parameter", "id": "startTime" },
          "right": { "source": "parameter", "id": "endTime" },
          "message": "The start time must be before the end time."
        }
      ]
    }
  ]
}
