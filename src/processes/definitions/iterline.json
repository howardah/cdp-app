{
  "schemaVersion": 1,
  "id": "iterline",
  "title": "Iteration Line",
  "category": "time-domain",
  "summary": "Repeat one sound along a transposition line.",
  "description": "Iterate a sound while following time and transposition instructions.",
  "useCases": ["Create pitched repeats"],
  "tags": ["iterate", "transpose", "line"],
  "identity": { "executable": "iterline", "operation": "iterline" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroextd.htm",
    "anchor": "ITERLINE",
    "helpCommand": ["iterline", "iterline"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "interpolate",
      "cliMode": 1,
      "title": "Interpolate",
      "summary": "Interpolate transpositions between events.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to repeat.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "transposition",
          "label": "Transposition line",
          "description": "Text file of time and semitone pairs.",
          "fileTypes": ["text-data"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "duration",
          "label": "Output duration",
          "description": "Output duration in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 10,
          "min": 0.01,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-iterline"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "iterline" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "input", "inputId": "transposition" },
        { "kind": "parameter", "parameterId": "duration" }
      ],
      "constraints": []
    }
  ]
}
