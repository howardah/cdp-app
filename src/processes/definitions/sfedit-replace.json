{
  "schemaVersion": 1,
  "id": "sfedit-replace",
  "title": "SFEdit Replace",
  "category": "edit-and-mix",
  "summary": "Replace a time range with another sound.",
  "description": "Insert a compatible soundfile while replacing a selected range.",
  "useCases": ["Replace a phrase", "Repair an edit"],
  "tags": ["replace", "splice", "edit"],
  "identity": {
    "executable": "sfedit",
    "operation": "replace"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroedit.htm",
    "anchor": "REPLACE",
    "helpCommand": ["sfedit", "replace"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "seconds",
      "cliMode": 1,
      "title": "Replace a range",
      "summary": "Replace a range",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to edit.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "insert",
          "label": "Inserted sound",
          "description": "Compatible sound to insert.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [
            {
              "kind": "sameSampleRate",
              "inputId": "source"
            },
            {
              "kind": "sameChannels",
              "inputId": "source"
            }
          ]
        }
      ],
      "parameters": [
        {
          "id": "time",
          "label": "Start",
          "description": "Start time in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.001
        },
        {
          "id": "endTime",
          "label": "End",
          "description": "End time in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 1,
          "min": 0,
          "step": 0.001
        },
        {
          "id": "spliceMs",
          "label": "Splice",
          "description": "Boundary splice window.",
          "required": false,
          "advanced": true,
          "unit": "ms",
          "cli": {
            "kind": "option",
            "flag": "-w",
            "join": "concatenated"
          },
          "kind": "number",
          "default": 15,
          "min": 0,
          "max": 500,
          "step": 1
        },
        {
          "id": "level",
          "label": "Level",
          "description": "Gain multiplier for inserted sound.",
          "required": false,
          "advanced": true,
          "unit": "×",
          "cli": {
            "kind": "option",
            "flag": "-l",
            "join": "concatenated"
          },
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 10,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-replace"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "replace"
        },
        {
          "kind": "mode"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "input",
          "inputId": "insert"
        },
        {
          "kind": "output"
        },
        {
          "kind": "parameter",
          "parameterId": "time"
        },
        {
          "kind": "parameter",
          "parameterId": "endTime"
        },
        {
          "kind": "parameter",
          "parameterId": "spliceMs"
        },
        {
          "kind": "parameter",
          "parameterId": "level"
        }
      ],
      "constraints": [
        {
          "kind": "lessThan",
          "left": {
            "source": "parameter",
            "id": "time"
          },
          "right": {
            "source": "parameter",
            "id": "endTime"
          },
          "message": "Start must be before end."
        }
      ]
    },
