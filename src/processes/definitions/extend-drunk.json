{
  "schemaVersion": 1,
  "id": "extend-drunk",
  "title": "Drunken Time Walk",
  "category": "time-domain",
  "summary": "Wander through a source while building a new sound.",
  "description": "Splice source segments selected by a controlled random walk into a continuous output.",
  "useCases": ["Create evolving textures", "Rework a field recording"],
  "tags": ["drunk", "random", "walk", "segments"],
  "identity": { "executable": "extend", "operation": "drunk" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroextd.htm",
    "anchor": "DRUNK",
    "helpCommand": ["extend", "drunk"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "walk",
      "cliMode": 1,
      "title": "Drunken walk",
      "summary": "Randomly walk through source segments.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source to walk through.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "outputDuration",
          "label": "Output duration",
          "description": "Minimum output duration in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 20,
          "min": 0.01,
          "step": 0.01
        },
        {
          "id": "locus",
          "label": "Center position",
          "description": "Starting source position in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.01
        },
        {
          "id": "ambitus",
          "label": "Walk range",
          "description": "Half-width of the source region in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0,
          "step": 0.01
        },
        {
          "id": "step",
          "label": "Maximum step",
          "description": "Maximum random step in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0.2,
          "min": 0.002,
          "step": 0.001
        },
        {
          "id": "clock",
          "label": "Segment duration",
          "description": "Time between segment reads in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0.5,
          "min": 0.001,
          "step": 0.001
        },
        {
          "id": "spliceMs",
          "label": "Splice",
          "description": "Segment splice length.",
          "required": false,
          "advanced": true,
          "unit": "ms",
          "cli": { "kind": "option", "flag": "-s", "join": "concatenated" },
          "kind": "number",
          "default": 15,
          "min": 0,
          "step": 1
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-drunk"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "drunk" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "outputDuration" },
        { "kind": "parameter", "parameterId": "locus" },
        { "kind": "parameter", "parameterId": "ambitus" },
        { "kind": "parameter", "parameterId": "step" },
        { "kind": "parameter", "parameterId": "clock" },
        { "kind": "parameter", "parameterId": "spliceMs" }
      ],
      "constraints": []
    }
  ]
}
