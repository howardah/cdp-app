{
  "schemaVersion": 1,
  "id": "pvoc-analyze",
  "title": "PVOC Analyze",
  "category": "spectral",
  "summary": "Convert a mono soundfile into spectral analysis data.",
  "description": "Prepare a sound for spectral transformation and resynthesis.",
  "useCases": ["Prepare material for PVOC processing", "Inspect spectral evolution"],
  "tags": ["pvoc", "analysis", "spectrum", "ana"],
  "identity": { "executable": "pvoc", "operation": "analyze" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cpvocman.htm",
    "anchor": "USAGEANAL",
    "helpCommand": ["pvoc", "analyze"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "analyze",
      "cliMode": 1,
      "title": "Analyze sound",
      "summary": "Create an analysis file from mono audio.",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "PVOC analysis requires one mono soundfile.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [{ "kind": "channels", "min": 1, "max": 1 }]
        }
      ],
      "parameters": [
        {
          "id": "points",
          "label": "Analysis points",
          "description": "FFT size; use a power of two.",
          "required": true,
          "advanced": false,
          "unit": "points",
          "cli": { "kind": "option", "flag": "-N", "join": "separate" },
          "kind": "integer",
          "default": 1024,
          "min": 2,
          "max": 32768,
          "step": 1
        },
        {
          "id": "overlap",
          "label": "Overlap",
          "description": "Analysis overlap factor.",
          "required": true,
          "advanced": false,
          "unit": "×",
          "cli": { "kind": "option", "flag": "-L", "join": "separate" },
          "kind": "integer",
          "default": 3,
          "min": 1,
          "max": 4,
          "step": 1
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "analysis-ana",
        "extension": "ana",
        "nameSuffix": "-analysis"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "analyze" },
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "parameter", "parameterId": "points" },
        { "kind": "parameter", "parameterId": "overlap" }
      ],
      "constraints": [
        {
          "kind": "powerOfTwo",
          "value": { "source": "parameter", "id": "points" },
          "message": "Analysis points must be a power of two between 2 and 32768."
        }
      ]
    }
  ]
}
