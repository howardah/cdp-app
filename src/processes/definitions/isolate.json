        },
        {
          "id": "dovetailMs",
          "label": "Dovetail overlap",
          "description": "Overlap of cut segments.",
          "required": false,
          "advanced": false,
          "unit": "ms",
          "cli": { "kind": "option", "flag": "-d", "join": "concatenated" },
          "kind": "number",
          "default": 5,
          "min": 0,
          "max": 20,
          "step": 1
        },
        {
          "id": "padEnd",
          "label": "Pad to source length",
          "description": "Add silence so segment files match source length.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-x" },
