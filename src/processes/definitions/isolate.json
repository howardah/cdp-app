{
  "schemaVersion": 1,
  "id": "isolate",
  "title": "Isolate",
  "category": "edit-and-mix",
  "summary": "Extract disjunct portions into separate files.",
  "description": "Cut soundfile segments by cuts, thresholds, or slice times while preserving their original positions.",
  "useCases": ["Extract snippets", "Separate speech syllables", "Process disjunct segments"],
  "tags": ["isolate", "cuts", "slice", "segments", "extract"],
  "identity": { "executable": "isolate" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroedit.htm",
    "anchor": "ISOLATE",
    "helpCommand": ["isolate", "isolate"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "single-segments",
      "cliMode": 1,
      "title": "One segment per output",
      "summary": "Create an output for each cuts-file segment.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source soundfile.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "cuts",
          "label": "Cuts data",
          "description": "Start/end time pairs in increasing order.",
          "fileTypes": ["cuts-data"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "spliceMs",
          "label": "Splice length",
          "description": "Length of segment splice.",
          "required": false,
          "advanced": false,
          "unit": "ms",
          "cli": { "kind": "option", "flag": "-s", "join": "concatenated" },
          "kind": "number",
          "default": 15,
          "min": 0,
          "max": 500,
          "step": 1
        },
        {
          "id": "padEnd",
          "label": "Pad to source length",
          "description": "Add silence so segment files match source length.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-x" },
          "kind": "flag",
          "default": false
        },
        {
          "id": "reverse",
          "label": "Reverse segments",
          "description": "Reverse cut segments, leaving remnant unchanged.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-r" },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "genericRoot",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-isolated",
        "discovery": { "prefixStyle": "root-number", "mayProduceRemnant": true }
      },
      "argumentOrder": [
        { "kind": "mode" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "input", "inputId": "cuts" },
        { "kind": "parameter", "parameterId": "spliceMs" },
        { "kind": "parameter", "parameterId": "padEnd" },
        { "kind": "parameter", "parameterId": "reverse" }
      ],
      "constraints": []
    },
    {
      "id": "grouped-segments",
      "cliMode": 2,
      "title": "Grouped segments",
      "summary": "Create outputs containing grouped cuts-file segments.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Source soundfile.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "cuts",
          "label": "Cuts data",
          "description": "Start/end time pairs in increasing order.",
