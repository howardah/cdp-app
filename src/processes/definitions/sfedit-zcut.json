{
  "schemaVersion": 1,
  "id": "sfedit-zcut",
  "title": "SFEdit Zero-Crossing Cut",
  "category": "edit-and-mix",
  "summary": "Keep a mono segment at zero crossings.",
  "description": "Extract a click-resistant segment without splice fades.",
  "useCases": ["Extract a clean sample", "Trim a mono recording"],
  "tags": ["zero-crossing", "cut", "trim", "mono"],
  "identity": {
    "executable": "sfedit",
    "operation": "zcut"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroedit.htm",
    "anchor": "ZCUT",
    "helpCommand": ["sfedit", "zcut"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "seconds",
      "cliMode": 1,
      "title": "Time in seconds",
      "summary": "Time in seconds",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "Mono sound to process.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [
            {
              "kind": "channels",
              "min": 1,
              "max": 1
            }
          ]
        }
      ],
      "parameters": [
        {
          "id": "start",
          "label": "Start",
          "description": "Approximate start time.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.01
        },
        {
          "id": "end",
          "label": "End",
          "description": "Approximate end time.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 1,
          "min": 0,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-zcut"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "zcut"
        },
        {
          "kind": "mode"
        },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        {
          "kind": "parameter",
          "parameterId": "start"
        },
        {
          "kind": "parameter",
          "parameterId": "end"
        }
      ],
      "constraints": [
        {
          "kind": "lessThan",
          "left": {
            "source": "parameter",
            "id": "start"
          },
          "right": {
            "source": "parameter",
            "id": "end"
          },
          "message": "Start must be before end."
        }
      ]
    },
    {
      "id": "samples",
      "cliMode": 2,
      "title": "Sample count",
      "summary": "Sample count",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "Mono sound to process.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [
            {
              "kind": "channels",
              "min": 1,
              "max": 1
            }
          ]
        }
      ],
      "parameters": [
        {
          "id": "start",
          "label": "Start",
          "description": "Approximate start sample.",
          "required": true,
          "advanced": false,
