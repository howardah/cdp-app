{
  "schemaVersion": 1,
  "id": "extend-repetitions",
  "title": "Timed Repetitions",
  "category": "time-domain",
  "summary": "Repeat a sound at specified times.",
  "description": "Place repeated performances of one sound at times listed in a text data file.",
  "useCases": ["Create rhythmic repeats", "Build a pulse texture"],
  "tags": ["repeat", "sequence", "times", "level"],
  "identity": { "executable": "extend", "operation": "repetitions" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroextd.htm",
    "anchor": "REPETITIONS",
    "helpCommand": ["extend", "repetitions"],
    "verifiedWithVersion": "CDP Release 7.1"
  },
  "modes": [
    {
      "id": "repeat",
      "title": "Repeat at times",
      "summary": "Use a timing file to place repeats.",
      "inputs": [
        {
          "id": "source",
          "label": "Soundfile",
          "description": "Sound to repeat.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        },
        {
          "id": "times",
          "label": "Times file",
          "description": "Text file containing playback times in seconds.",
          "fileTypes": ["text-data"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "level",
          "label": "Level",
          "description": "Output level for each repeat.",
          "required": true,
          "advanced": false,
          "unit": "×",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-repetitions"
      },
      "argumentOrder": [
        { "kind": "literal", "value": "repetitions" },
        { "kind": "input", "inputId": "source" },
        { "kind": "output" },
        { "kind": "input", "inputId": "times" },
        { "kind": "parameter", "parameterId": "level" }
      ],
      "constraints": []
    }
  ]
}
