{
  "schemaVersion": 1,
  "id": "distort-pulsed",
  "title": "Distort pulsed",
  "category": "time-domain",
  "summary": "Create an impulse train from a mono source.",
  "description": "Impose or synthesize a pulsed impulse train from mono source material.",
  "useCases": ["Impulse-train sound design"],
  "tags": ["distort", "pulsed", "impulse"],
  "identity": { "executable": "distort", "operation": "pulsed" },
  "documentation": {
    "localPath": "cdpr8/docs/html/cdistort.htm",
    "anchor": "PULSED",
    "helpCommand": ["distort", "pulsed"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "impulse-train",
      "cliMode": 1,
      "title": "Impose impulse train",
      "summary": "Impose impulses on a mono source.",
      "inputs": [
        {
          "id": "source",
          "label": "Mono soundfile",
          "description": "Source sound.",
          "fileTypes": ["soundfile"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": [{ "kind": "channels", "min": 1, "max": 1 }]
        }
      ],
      "parameters": [
        {
          "id": "start",
          "label": "Start",
          "description": "Impulse start in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.001
        },
        {
          "id": "duration",
          "label": "Duration",
          "description": "Impulse duration in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0.001,
          "step": 0.001
        },
        {
          "id": "frequency",
          "label": "Frequency",
          "description": "Impulse frequency.",
          "required": true,
          "advanced": false,
          "unit": "Hz",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 5,
          "min": 0.1,
          "max": 50,
          "step": 0.01
        },
        {
          "id": "frequencyRandomness",
          "label": "Frequency randomness",
          "description": "Frequency variation in semitones.",
          "required": true,
          "advanced": false,
          "unit": "semitones",
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 12,
          "step": 0.01
        },
        {
          "id": "timingRandomness",
          "label": "Timing randomness",
          "description": "Peak and trough timing variation.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "id": "amplitudeRandomness",
          "label": "Amplitude randomness",
          "description": "Impulse-shape variation.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "id": "transposition",
          "label": "Transposition contour",
          "description": "Breakpoint file of time/semitone-shift pairs.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "file",
          "fileTypes": ["breakpoint"]
        },
        {
          "id": "transpositionRandomness",
          "label": "Transposition randomness",
          "description": "Contour variation between impulses.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "id": "keepStart",
          "label": "Keep source start",
          "description": "Keep source material before the impulses.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-s" },
          "kind": "flag",
          "default": false
        },
        {
          "id": "keepEnd",
          "label": "Keep source end",
          "description": "Keep source material after the impulses.",
          "required": false,
          "advanced": true,
          "cli": { "kind": "booleanFlag", "flag": "-e" },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
        "nameSuffix": "-pulsed"
