          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "time",
          "label": "Time",
          "description": "Position in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 0,
          "min": 0,
          "step": 0.001
        },
        {
          "id": "duration",
          "label": "Duration",
          "description": "Duration in seconds.",
          "required": true,
          "advanced": false,
          "unit": "s",
          "cli": {
            "kind": "positional"
          },
          "kind": "number",
          "default": 1,
          "min": 0.001,
          "step": 0.001
        },
        {
          "id": "spliceMs",
          "label": "Splice",
          "description": "Boundary splice window.",
          "required": false,
          "advanced": true,
          "unit": "ms",
          "cli": {
            "kind": "option",
            "flag": "-w",
            "join": "concatenated"
          },
          "kind": "number",
          "default": 15,
          "min": 0,
          "max": 500,
          "step": 1
        },
        {
          "id": "overwrite",
          "label": "Overwrite",
          "description": "Overwrite existing audio instead of shifting it.",
          "required": false,
          "advanced": true,
          "cli": {
            "kind": "booleanFlag",
            "flag": "-o"
          },
          "kind": "flag",
          "default": false
        },
        {
          "id": "retainEnd",
          "label": "Retain end",
          "description": "Retain silence written beyond the original end.",
          "required": false,
          "advanced": true,
          "cli": {
            "kind": "booleanFlag",
            "flag": "-s"
          },
          "kind": "flag",
          "default": false
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "soundfile",
        "extension": "wav",
