{
  "schemaVersion": 1,
  "id": "sfedit-insil",
  "title": "SFEdit Insert Silence",
  "category": "edit-and-mix",
  "summary": "Insert silence into a soundfile.",
  "description": "Create space or overwrite a region with silence.",
  "useCases": ["Insert pauses", "Create gaps"],
  "tags": ["silence", "pause", "gap", "edit"],
  "identity": {
    "executable": "sfedit",
    "operation": "insil"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/cgroedit.htm",
