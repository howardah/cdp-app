{
  "schemaVersion": 1,
  "id": "repitch-exag",
  "title": "Repitch exag",
  "category": "spectral",
  "summary": "CDP Repitch exag operation.",
  "description": "Run the documented CDP Release 8 Repitch exag operation through the desktop process runner.",
  "useCases": ["Explore a CDP process", "Build an audio-processing workflow"],
  "tags": ["repitch", "exag", "cdp-release-8"],
  "identity": {
    "executable": "repitch",
    "operation": "exag"
  },
  "documentation": {
    "localPath": "cdpr8/docs/html/crepitch.htm",
    "helpCommand": ["repitch", "exag"],
    "verifiedWithVersion": "CDP Release 8"
  },
  "modes": [
    {
      "id": "process",
      "title": "Repitch exag",
      "summary": "Run Repitch exag.",
      "inputs": [
        {
          "id": "source",
          "label": "Binary pitch file",
          "description": "Source required by CDP Repitch exag.",
          "fileTypes": ["binary-pitch"],
          "minItems": 1,
          "maxItems": 1,
          "ordered": false,
          "constraints": []
        }
      ],
      "parameters": [
        {
          "id": "meanPitch",
          "label": "Mean pitch",
          "description": "MIDI pitch around which to exaggerate intervals.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 60,
          "min": 0,
          "max": 127,
          "step": 0.01
        },
        {
          "id": "range",
          "label": "Range exaggeration",
          "description": "Multiplier for pitch-range intervals.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0.001,
          "step": 0.001
        },
        {
          "id": "contour",
          "label": "Contour exaggeration",
          "description": "Pitch-contour exaggeration from 0 to 1.",
          "required": true,
          "advanced": false,
          "cli": { "kind": "positional" },
          "kind": "number",
          "default": 1,
          "min": 0,
          "max": 1,
          "step": 0.001
        }
      ],
      "output": {
        "kind": "singleFile",
        "fileType": "binary-pitch",
        "extension": "frq",
        "nameSuffix": "-exag"
      },
      "argumentOrder": [
        {
          "kind": "literal",
          "value": "exag"
        },
        { "kind": "literal", "value": "5" },
        {
          "kind": "input",
          "inputId": "source"
        },
        {
          "kind": "output"
        },
        { "kind": "parameter", "parameterId": "meanPitch" },
        { "kind": "parameter", "parameterId": "range" },
        { "kind": "parameter", "parameterId": "contour" }
      ],
      "constraints": []
    }
  ]
}
